{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "containerPort", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" },
        "allowTag": { "type": "boolean" },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      },
      "if": { "properties": { "allowTag": { "const": true } }, "required": ["allowTag"] },
      "then": { "properties": { "tag": { "type": "string", "minLength": 1 } }, "required": ["tag"] },
      "else": { "properties": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }, "required": ["digest"] }
    },
    "containerPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "replicas": { "type": "integer", "minimum": 1 },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "envFromSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "secret", "key"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "secret": { "type": "string" }, "key": { "type": "string" } }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["memory"] }
      }
    }
  }
}
